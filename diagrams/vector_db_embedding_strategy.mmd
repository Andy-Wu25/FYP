%%{init: {
  'theme': 'base',
  'themeVariables': {
    'primaryColor': '#ffffff',
    'primaryBorderColor': '#000000',
    'primaryTextColor': '#000000',
    'secondaryColor': '#ffffff',
    'lineColor': '#000000',
    'fontSize': '14px',
    'fontFamily': 'Times New Roman, serif'
  },
  'flowchart': { 'curve': 'basis', 'nodeSpacing': 50, 'rankSpacing': 60 }
}}%%

flowchart TD
    INPUT["Input Text\n(code element source)"]

    CHECK{"len(text)\n> max_chars?"}

    subgraph SHORT ["Short Text Path"]
        direction TB
        DIRECT["Single text\n(no splitting)"]
    end

    subgraph LONG ["Long Text Handling"]
        direction TB
        MODE{"long_text_mode?"}

        subgraph CHUNK_PATH ["Chunking (mode = chunk)"]
            direction TB
            SLIDE["Sliding Window\nstep = max_chars − overlap"]
            C1["Chunk 1\n[0 : max_chars]"]
            C2["Chunk 2\n[step : step + max_chars]"]
            CN["Chunk N\n[... : end]"]
            SLIDE --> C1
            SLIDE --> C2
            SLIDE --> CN
        end

        subgraph TRUNC_PATH ["Truncation (mode = truncate)"]
            direction TB
            CUT["text[:max_chars]"]
        end

        MODE -->|"chunk"| CHUNK_PATH
        MODE -->|"truncate"| TRUNC_PATH
    end

    PREFIX["Prepend input_prefix\n(if configured)"]

    VLLM(("vLLM Server\nPOST /v1/embeddings\n(batched)"))

    AVG{"Multiple\nchunks?"}

    MERGE["Component-wise\nVector Average\nv = Σvᵢ / N"]

    SINGLE["Single Vector\n(returned as-is)"]

    OUTPUT["Final Embedding\nVector"]

    INPUT --> CHECK
    CHECK -->|"No\n(or max_chars = 0)"| SHORT
    CHECK -->|"Yes"| LONG
    SHORT --> PREFIX
    CHUNK_PATH --> PREFIX
    TRUNC_PATH --> PREFIX
    PREFIX --> VLLM
    VLLM --> AVG
    AVG -->|"Yes"| MERGE --> OUTPUT
    AVG -->|"No"| SINGLE --> OUTPUT

    classDef default fill:#fff,stroke:#000,stroke-width:2px,color:#000
    classDef decision fill:#fff,stroke:#000,stroke-width:2px,color:#000

    class INPUT,DIRECT,SLIDE,C1,C2,CN,CUT,PREFIX,MERGE,SINGLE,OUTPUT default
    class CHECK,MODE,AVG decision
    class VLLM default

    style SHORT fill:none,stroke:#000,stroke-width:1.5px,stroke-dasharray: 6 4
    style LONG fill:none,stroke:#000,stroke-width:1.5px,stroke-dasharray: 6 4
    style CHUNK_PATH fill:none,stroke:#000,stroke-width:1px,stroke-dasharray: 4 3
    style TRUNC_PATH fill:none,stroke:#000,stroke-width:1px,stroke-dasharray: 4 3
