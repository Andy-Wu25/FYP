%%{init: {
  'theme': 'base',
  'themeVariables': {
    'primaryColor': '#ffffff',
    'primaryBorderColor': '#000000',
    'primaryTextColor': '#000000',
    'secondaryColor': '#ffffff',
    'lineColor': '#000000',
    'fontSize': '14px',
    'fontFamily': 'Times New Roman, serif'
  },
  'flowchart': { 'curve': 'basis', 'nodeSpacing': 50, 'rankSpacing': 60 }
}}%%

flowchart TD
    CLIENT["<b>CodeVectorStore</b>\n(Application Layer)"]

    subgraph CHROMA ["ChromaDB PersistentClient"]
        direction TB

        subgraph PRIV ["Private Collection (hnsw:cosine)"]
            direction LR
            PRIV_HNSW["HNSW\nIndex"]
            PRIV_META["Metadata\nStore"]
            PRIV_DOC["Document\nStore"]
        end

        subgraph PUB ["Public Collection (hnsw:cosine)"]
            direction LR
            PUB_HNSW["HNSW\nIndex"]
            PUB_META["Metadata\nStore"]
            PUB_DOC["Document\nStore"]
        end

        SQLITE[("chroma.sqlite3\n(Persistence Layer)")]
    end

    subgraph DISK ["Disk Storage (~/.code-sim/chroma/)"]
        direction LR
        DB_FILES["SQLite DB +\nHNSW Binaries"]
        CFG_PRIV["_embedding_config\n_private.json"]
        CFG_PUB["_embedding_config\n_public.json"]
    end

    CLIENT -->|"Upsert / Query\n/ Delete"| CHROMA
    PRIV_HNSW --- SQLITE
    PRIV_META --- SQLITE
    PRIV_DOC --- SQLITE
    PUB_HNSW --- SQLITE
    PUB_META --- SQLITE
    PUB_DOC --- SQLITE
    SQLITE -->|"Persisted"| DISK

    classDef default fill:#fff,stroke:#000,stroke-width:2px,color:#000
    classDef storeNode fill:#fff,stroke:#000,stroke-width:1.5px,color:#000

    class CLIENT,PRIV_HNSW,PRIV_META,PRIV_DOC,PUB_HNSW,PUB_META,PUB_DOC storeNode
    class SQLITE,DB_FILES,CFG_PRIV,CFG_PUB default

    style CHROMA fill:none,stroke:#000,stroke-width:2px,stroke-dasharray: 6 4
    style PRIV fill:none,stroke:#000,stroke-width:1.5px
    style PUB fill:none,stroke:#000,stroke-width:1.5px
    style DISK fill:none,stroke:#000,stroke-width:1.5px,stroke-dasharray: 6 4
