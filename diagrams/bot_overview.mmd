%%{init: {
  'theme': 'base',
  'themeVariables': {
    'primaryColor': '#ffffff',
    'primaryBorderColor': '#000000',
    'primaryTextColor': '#000000',
    'secondaryColor': '#ffffff',
    'lineColor': '#000000',
    'fontSize': '14px',
    'fontFamily': 'Times New Roman, serif'
  },
  'flowchart': { 'curve': 'basis', 'nodeSpacing': 50, 'rankSpacing': 60 }
}}%%

flowchart LR
    DEV(["Developer"]) <-->|"Opens PR /\nReceives Report"| GH["<b>GitHub Platform</b>"]

    GH -->|"Webhook\nEvent"| WEBHOOK

    subgraph BOT ["GitHub PR Bot (FastAPI Server)"]
        direction TB
        WEBHOOK["Webhook\nHandler"] -->|"PR Files\n& Content"| ANALYZER["PR Analysis\nEngine"]
        ANALYZER -->|"Findings"| FORMATTER["Report\nFormatter"]
    end

    FORMATTER -->|"Post / Update\nPR Comment"| GH

    ANALYZER <-->|"Embed Changed\nCode Elements"| MODEL(("Embedding\nModel"))
    ANALYZER <-->|"Query Similar\nMatches"| DB[("Vector\nDatabase\n(ChromaDB)")]

    classDef default fill:#fff,stroke:#000,stroke-width:2px,color:#000
    classDef modelNode fill:#fff,stroke:#000,stroke-width:2.5px,color:#000
    classDef userNode fill:#fff,stroke:#000,stroke-width:2px,color:#000

    class MODEL modelNode
    class DEV userNode
    class GH,WEBHOOK,ANALYZER,FORMATTER default
    class DB default

    style BOT fill:none,stroke:#000,stroke-width:2px,stroke-dasharray: 6 4

    linkStyle 0 stroke:#000,stroke-width:1.5px
    linkStyle 1 stroke:#000,stroke-width:1.5px
    linkStyle 2 stroke:#000,stroke-width:1.5px
    linkStyle 3 stroke:#000,stroke-width:1.5px
    linkStyle 4 stroke:#000,stroke-width:1.5px
    linkStyle 5 stroke:#000,stroke-width:1.5px
    linkStyle 6 stroke:#1a5276,stroke-width:1.5px
