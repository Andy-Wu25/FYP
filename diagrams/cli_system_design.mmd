flowchart TD
    %% ══════════════════════════════════════════════════
    %% LAYER 1 — CLI Entry Points (pyproject.toml scripts)
    %% ══════════════════════════════════════════════════
    subgraph L1["<b>CLI Entry Points</b>  ·  pyproject.toml [project.scripts]"]
        direction LR
        subgraph L1_IDX["Indexing Commands"]
            direction TB
            IDX["<b>code-sim-index</b>\n<code>indexing/index.py:main()</code>\n<i>sync_current_repo()</i>"]
            IDX_PUB["<b>code-sim-index-public</b>\n<code>indexing/public_index.py:main()</code>\n<i>index_public_github_repo()</i>"]
            IDX_PRIV["<b>code-sim-index-private</b>\n<code>indexing/index.py:main_private_url()</code>\n<i>index_private_github_repo()</i>"]
            UPD["<b>code-sim-update</b>\n<code>indexing/update.py:main()</code>"]
            REM["<b>code-sim-remove-public</b>\n<code>indexing/public_remove.py:main()</code>"]
        end
        subgraph L1_CHK["Checking Commands"]
            direction TB
            CHK["<b>code-sim-check</b>\n<code>checking/code_similarity.py:main()</code>\n<i>_run_check(private+public)</i>"]
            CHK_PUB["<b>code-sim-check-public</b>\n<code>checking/check_public.py:main()</code>"]
            CHK_SELF["<b>code-sim-check-self</b>\n<code>checking/check_self.py:main()</code>"]
            CHK_PRIV["<b>code-sim-check-private</b>\n<code>checking/code_similarity.py:main_private()</code>"]
        end
        subgraph L1_TOOL["Utility Commands"]
            direction TB
            EVAL["<b>code-sim-eval</b>\n<code>tools/evaluate.py:main()</code>\n<i>run_evaluation()</i>"]
            STATS["<b>code-sim-stats</b>\n<code>tools/stats.py:main()</code>\n<i>render_dashboard()</i>"]
            SNAP["<b>code-sim-snapshot-*</b>\n<code>tools/snapshot.py</code>\n<i>cmd_save/load/list/delete()</i>"]
            CFG["<b>code-sim-config</b>\n<code>tools/config.py:main()</code>"]
        end
    end

    %% ══════════════════════════════════════════════════
    %% LAYER 2 — Runtime Context
    %% ══════════════════════════════════════════════════
    subgraph L2["<b>core/runtime.py</b>"]
        direction LR
        RC["<b>RuntimeContext</b> dataclass\n<code>repo_root · repo_name · repo_id\norg_id · db_path · metric\nprivate_collection_name\npublic_collection_name</code>"]
        RC_FN["<b>load_runtime_context()</b>\ngit rev-parse → repo root\nenv vars → org_id, db_path\nhash(remote URL) → repo_id"]
        GIT_FN["<b>Git helpers</b>\nfind_repo_root()\nstaged_added_modified_renamed()\nstaged_hunk_line_ranges()\nread_index_blob()\niter_repo_source_files()"]
    end

    %% ══════════════════════════════════════════════════
    %% LAYER 3 — Source Collection & Filtering
    %% ══════════════════════════════════════════════════
    subgraph L3["<b>Source Collection &amp; Filtering</b>"]
        direction LR
        SCOPE["<b>checking/check_utils.py</b>\nquery_elements_from_args()\n<i>resolve scope:\nstaged → git diff --cached\nfiles → explicit paths\nrepo → rglob all files</i>"]
        IGN["<b>core/ignore.py</b>\nIgnoreMatcher class\nload_ignore_file()\n<i>.code-simignore\ngitignore-style glob rules</i>"]
        SRC["<b>core/source_filtering.py</b>\nis_noise_source_path()\n<i>EXCLUDED_DIR_NAMES\nEXCLUDED_EXTENSIONS\nEXCLUDED_EXACT_FILENAMES</i>"]
        LANG["<b>core/language_detection.py</b>\ndetect_tree_sitter_language()\nhas_language_hint()\nis_probably_binary()\n<i>identify lib + SUFFIX_TO_TREE_SITTER\n+ HINT_TO_TREE_SITTER maps</i>"]
        SCOPE --> IGN --> SRC --> LANG
    end

    %% ══════════════════════════════════════════════════
    %% LAYER 4 — Code Parsing
    %% ══════════════════════════════════════════════════
    subgraph L4["<b>core/code_parser.py</b>"]
        direction LR
        PARSE["<b>extract_code_elements()</b>\nTree-sitter parse → AST\n_iter_named_nodes(root)\n_is_declaration_like_node_type()\n_name_for_declaration()"]
        ELEM["<b>CodeElement</b> TypedDict\n<code>id · name · kind\nstart_line · end_line\ntext · hash</code>"]
        FB["<b>_file_level_elements()</b>\nFallback: whole file\nas single element"]
        MAKE_ID["<b>make_element_id()</b>\nsha256(org:repo:path:hash)"]
        PARSE --> ELEM
        PARSE -.->|"no declarations\nor parse failure"| FB --> ELEM
    end

    %% ══════════════════════════════════════════════════
    %% LAYER 5 — Embedding
    %% ══════════════════════════════════════════════════
    subgraph L5["<b>infra/embeddings.py</b>"]
        direction LR
        EC["<b>EmbeddingClient</b>\n<code>base_url · model · batch_size\nmax_chars · long_text_mode\nchunk_overlap · input_prefix</code>"]
        EC_EMB["<b>embed_documents()</b>\n_split_long_text() → chunks\n_embed_batch() → HTTP POST\n_average_vectors() → merge"]
        EC_CFG["<b>save/load_embedding_config()</b>\nPersist index-time settings\nto match at query time"]
    end

    VLLM[("<b>vLLM Embedding Server</b>\n<code>POST /v1/embeddings</code>\n<i>OpenAI-compatible API\nmodel: Octen-Embedding-8B\nconfigurable via VLLM_* env vars</i>")]

    %% ══════════════════════════════════════════════════
    %% LAYER 6 — Vector Store
    %% ══════════════════════════════════════════════════
    subgraph L6["<b>infra/clients.py</b>  ·  CodeVectorStore"]
        direction LR
        CVS_W["<b>Write Operations</b>\nupsert_private_code_elements()\nupsert_public_code_elements()\ndelete_private_repo_entries()\ndelete_public_source_entries()\ndelete_*_stale_entries()"]
        CVS_R["<b>Read Operations</b>\nquery_private_by_embedding()\nquery_private_repo_by_embedding()\nquery_public_by_embedding()\n<i>optional license filter</i>"]
        PRIV_C[("Private\nCollection\n<i>hnsw:cosine</i>")]
        PUB_C[("Public\nCollection\n<i>hnsw:cosine</i>")]
        CVS_W --- PRIV_C
        CVS_W --- PUB_C
        CVS_R --- PRIV_C
        CVS_R --- PUB_C
    end

    CHROMA[("<b>ChromaDB</b>\nPersistentClient\n<i>chroma.sqlite3 + HNSW index</i>\n<code>~/.code-sim/chroma/</code>")]

    %% ══════════════════════════════════════════════════
    %% LAYER 7 — Similarity Checking
    %% ══════════════════════════════════════════════════
    subgraph L7["<b>checking/check_utils.py</b>  ·  Hit Processing"]
        direction LR
        QE["<b>query_elements_from_args()</b>\ncollect_staged_query_elements()\ncollect_full_file_query_elements()"]
        EH["<b>extract_hits()</b>\nover-fetch pool (top_k×4)\ninclude_hit filter callback\nmax_distance threshold\ntop-k selection"]
        FMT["<b>Formatting</b>\nfmt_header_box()\nfmt_query_header()\nfmt_private_hit()\nfmt_public_hit()\nfmt_footer()"]
    end

    %% ══════════════════════════════════════════════════
    %% LAYER 8 — Output
    %% ══════════════════════════════════════════════════
    subgraph L8["<b>Output</b>"]
        direction LR
        TERM["<b>Terminal</b>\nANSI dashboard\ndistance colour badges"]
        JSON["<b>JSON export</b>\n--json FILE flag\nstructured results"]
        METRICS["<b>Eval metrics</b>\n<code>tools/evaluate.py</code>\nP@k · MRR · nDCG\nhit rate · CDF\nlatency · scalability"]
        LINKS["<b>infra/public_links.py</b>\nbuild_github_blob_url()\nbuild_public_match_permalink()"]
    end

    %% ══════════════════════════════════════════════════
    %% CONNECTIONS
    %% ══════════════════════════════════════════════════
    L1 --> L2
    L2 --> L3
    L3 --> L4
    L4 -->|"indexing:\nindex.py / public_index.py\nembed elements → store"| L5
    L5 -->|"HTTP POST /v1/embeddings"| VLLM
    VLLM -->|"float[] vectors"| L5
    L5 -->|"upsert vectors + metadata"| L6
    L6 --- CHROMA
    L4 -->|"checking:\ncode_similarity.py / check_public.py\nembed queries → search"| L7
    L5 -.->|"embed query elements"| L7
    L6 -.->|"cosine similarity results"| L7
    L7 --> L8

